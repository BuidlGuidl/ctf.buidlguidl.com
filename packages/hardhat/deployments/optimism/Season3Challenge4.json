  "metadata": "{\"compiler\":{\"version\":\"0.8.20+commit.a1b79de6\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_nftContract\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[],\"name\":\"KEY_VALUE\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"MIN_POWER\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"TARGET_LEVEL\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"active\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"climb\",\"outputs\":[],\"stateMutability\":\"payable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"levels\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint8\",\"name\":\"power\",\"type\":\"uint8\"}],\"name\":\"mintFlag\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"nftContract\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"paid\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"sessionSolver\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"solverOwner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/S3/Season3Challenge4.sol\":\"Season3Challenge4\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/INFTFlags.sol\":{\"content\":\"//SPDX-License-Identifier: MIT\\npragma solidity >=0.8.0 <0.9.0;\\n\\ninterface INFTFlags {\\n    function mint(address _recipient, uint256 _challengeId) external;\\n\\n    function hasMinted(address _recipient, uint256 _challengeId) external view returns (bool);\\n\\n    function tokenIdCounter() external view returns (uint256);\\n\\n    function finalBossUnlocked(address _player) external view returns (bool);\\n}\\n\",\"keccak256\":\"0x4fc291ba5c8d831c1e684b955499b3ee523e611556b6de7cd83fced9de10d31e\",\"license\":\"MIT\"},\"contracts/S3/Season3Challenge4.sol\":{\"content\":\"//SPDX-License-Identifier: MIT\\npragma solidity >=0.8.0 <0.9.0;\\n\\nimport \\\"../INFTFlags.sol\\\";\\n\\ncontract Season3Challenge4 {\\n    address public nftContract;\\n\\n    uint8 public constant TARGET_LEVEL = 5;\\n    uint8 public constant KEY_VALUE = 64;\\n    uint8 public constant MIN_POWER = 150;\\n\\n    mapping(address => bool) public active;\\n    mapping(address => uint8) public levels;\\n    mapping(address => uint256) public paid;\\n    mapping(address => address) public solverOwner;\\n    mapping(address => address) public sessionSolver;\\n\\n    constructor(address _nftContract) {\\n        nftContract = _nftContract;\\n    }\\n\\n    function mintFlag(uint8 power) external {\\n        require(msg.sender != tx.origin, \\\"Must call from contract\\\");\\n        _bindSolver();\\n\\n        active[tx.origin] = true;\\n        levels[tx.origin] = 0;\\n        paid[tx.origin] = 0;\\n        sessionSolver[tx.origin] = msg.sender;\\n\\n        (bool ok, ) = msg.sender.call(\\\"\\\");\\n        require(ok, \\\"callback failed\\\");\\n\\n        active[tx.origin] = false;\\n\\n        uint8 level = levels[tx.origin];\\n        require(level == TARGET_LEVEL, \\\"Wrong level\\\");\\n        require(paid[tx.origin] == uint256(TARGET_LEVEL) * 1 gwei, \\\"Wrong total paid\\\");\\n        require(power * level >= MIN_POWER, \\\"Not enough power\\\");\\n        require(power << level == KEY_VALUE, \\\"Wrong key value\\\");\\n\\n        INFTFlags(nftContract).mint(tx.origin, 4);\\n    }\\n\\n    function climb() external payable {\\n        require(active[tx.origin], \\\"No active session\\\");\\n        require(msg.sender == sessionSolver[tx.origin], \\\"Wrong solver\\\");\\n        require(msg.value == (uint256(levels[tx.origin]) + 1) * 1 gwei, \\\"Wrong payment\\\");\\n        paid[tx.origin] += msg.value;\\n\\n        (bool ok, ) = msg.sender.call(\\\"\\\");\\n        require(ok, \\\"callback failed\\\");\\n\\n        levels[tx.origin] += 1;\\n    }\\n\\n    function _bindSolver() private {\\n        address owner = solverOwner[msg.sender];\\n        if (owner == address(0)) {\\n            solverOwner[msg.sender] = tx.origin;\\n        } else {\\n            require(owner == tx.origin, \\\"Solver bound to another agent\\\");\\n        }\\n    }\\n}\\n\",\"keccak256\":\"0xe9ed804e1ac1bba845e7cf06557e97561e9a4c882c8c4feb341ed67aad83b04c\",\"license\":\"MIT\"}},\"version\":1}",
