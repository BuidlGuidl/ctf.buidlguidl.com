  "metadata": "{\"compiler\":{\"version\":\"0.8.20+commit.a1b79de6\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_nftContract\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[{\"internalType\":\"uint256[]\",\"name\":\"data1\",\"type\":\"uint256[]\"},{\"internalType\":\"uint256[]\",\"name\":\"data2\",\"type\":\"uint256[]\"}],\"name\":\"mintFlag\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"nftContract\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/S3/Season3Challenge5.sol\":\"Season3Challenge5\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/INFTFlags.sol\":{\"content\":\"//SPDX-License-Identifier: MIT\\npragma solidity >=0.8.0 <0.9.0;\\n\\ninterface INFTFlags {\\n    function mint(address _recipient, uint256 _challengeId) external;\\n\\n    function hasMinted(address _recipient, uint256 _challengeId) external view returns (bool);\\n\\n    function tokenIdCounter() external view returns (uint256);\\n\\n    function finalBossUnlocked(address _player) external view returns (bool);\\n}\\n\",\"keccak256\":\"0x4fc291ba5c8d831c1e684b955499b3ee523e611556b6de7cd83fced9de10d31e\",\"license\":\"MIT\"},\"contracts/S3/Season3Challenge5.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\npragma solidity >=0.8.0 <0.9.0;\\n\\nimport \\\"../INFTFlags.sol\\\";\\n\\ncontract Season3Challenge5 {\\n    address public nftContract;\\n\\n    constructor(address _nftContract) {\\n        nftContract = _nftContract;\\n    }\\n\\n    function mintFlag(uint256[] calldata data1, uint256[] calldata data2) external {\\n        bytes32 seed = keccak256(abi.encodePacked(tx.origin, address(this)));\\n\\n        uint256 tag;\\n        uint256 size;\\n        assembly {\\n            tag := calldataload(0x44)\\n            size := calldatasize()\\n        }\\n\\n        require(size == 0xe4, \\\"Wrong size\\\");\\n        require(address(uint160(tag)) == tx.origin, \\\"Wrong tag\\\");\\n        require(uint96(tag >> 160) == uint96(bytes12(seed)), \\\"Dirty tag\\\");\\n\\n        require(data1.length == 3, \\\"Wrong data1 length\\\");\\n        require(data2.length == 2, \\\"Wrong data2 length\\\");\\n        require(data1[1] == uint256(seed), \\\"Wrong data1\\\");\\n        require(data2[1] == ~uint256(seed), \\\"Wrong data2\\\");\\n\\n        INFTFlags(nftContract).mint(tx.origin, 5);\\n    }\\n}\\n\",\"keccak256\":\"0xd379cfdce581780198165f07770b745d5196a1b26625f4e8694e9534a733dd76\",\"license\":\"MIT\"}},\"version\":1}",
