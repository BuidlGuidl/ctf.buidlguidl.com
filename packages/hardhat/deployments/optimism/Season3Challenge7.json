  "metadata": "{\"compiler\":{\"version\":\"0.8.20+commit.a1b79de6\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_nftContract\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"player\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"id\",\"type\":\"bytes32\"}],\"name\":\"OperationExecuted\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"player\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"id\",\"type\":\"bytes32\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"readyAt\",\"type\":\"uint256\"}],\"name\":\"OperationScheduled\",\"type\":\"event\"},{\"inputs\":[],\"name\":\"DEFAULT_DELAY\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"MAX_DELAY\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"player\",\"type\":\"address\"}],\"name\":\"delayOf\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address[]\",\"name\":\"targets\",\"type\":\"address[]\"},{\"internalType\":\"bytes[]\",\"name\":\"dataElements\",\"type\":\"bytes[]\"},{\"internalType\":\"bytes32\",\"name\":\"salt\",\"type\":\"bytes32\"}],\"name\":\"execute\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address[]\",\"name\":\"targets\",\"type\":\"address[]\"},{\"internalType\":\"bytes[]\",\"name\":\"dataElements\",\"type\":\"bytes[]\"},{\"internalType\":\"bytes32\",\"name\":\"salt\",\"type\":\"bytes32\"}],\"name\":\"getOperationId\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"pure\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"account\",\"type\":\"address\"}],\"name\":\"grantProposer\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"mintFlag\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"nftContract\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"proposers\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"},{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"name\":\"readyAt\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address[]\",\"name\":\"targets\",\"type\":\"address[]\"},{\"internalType\":\"bytes[]\",\"name\":\"dataElements\",\"type\":\"bytes[]\"},{\"internalType\":\"bytes32\",\"name\":\"salt\",\"type\":\"bytes32\"}],\"name\":\"schedule\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"name\":\"solverOwner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint64\",\"name\":\"newDelay\",\"type\":\"uint64\"}],\"name\":\"updateDelay\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/S3/Season3Challenge7.sol\":\"Season3Challenge7\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/INFTFlags.sol\":{\"content\":\"//SPDX-License-Identifier: MIT\\npragma solidity >=0.8.0 <0.9.0;\\n\\ninterface INFTFlags {\\n    function mint(address _recipient, uint256 _challengeId) external;\\n\\n    function hasMinted(address _recipient, uint256 _challengeId) external view returns (bool);\\n\\n    function tokenIdCounter() external view returns (uint256);\\n\\n    function finalBossUnlocked(address _player) external view returns (bool);\\n}\\n\",\"keccak256\":\"0x4fc291ba5c8d831c1e684b955499b3ee523e611556b6de7cd83fced9de10d31e\",\"license\":\"MIT\"},\"contracts/S3/Season3Challenge7.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\npragma solidity >=0.8.0 <0.9.0;\\n\\nimport \\\"../INFTFlags.sol\\\";\\n\\ncontract Season3Challenge7 {\\n    uint256 public constant DEFAULT_DELAY = 7 days;\\n    uint256 public constant MAX_DELAY = 14 days;\\n\\n    address public nftContract;\\n\\n    mapping(address => mapping(address => bool)) public proposers;\\n    mapping(address => mapping(bytes32 => uint256)) public readyAt;\\n    mapping(address => uint256) private _delays;\\n    mapping(address => bool) private _delaySet;\\n    mapping(address => address) public solverOwner;\\n\\n    event OperationScheduled(address indexed player, bytes32 indexed id, uint256 readyAt);\\n    event OperationExecuted(address indexed player, bytes32 indexed id);\\n\\n    constructor(address _nftContract) {\\n        nftContract = _nftContract;\\n    }\\n\\n    modifier onlySelf() {\\n        require(msg.sender == address(this), \\\"Only the timelock itself\\\");\\n        _;\\n    }\\n\\n    function delayOf(address player) public view returns (uint256) {\\n        return _delaySet[player] ? _delays[player] : DEFAULT_DELAY;\\n    }\\n\\n    function getOperationId(\\n        address[] calldata targets,\\n        bytes[] calldata dataElements,\\n        bytes32 salt\\n    ) public pure returns (bytes32) {\\n        return keccak256(abi.encode(targets, dataElements, salt));\\n    }\\n\\n    function schedule(address[] calldata targets, bytes[] calldata dataElements, bytes32 salt) external {\\n        _bindSolver();\\n        require(proposers[tx.origin][msg.sender], \\\"Not a proposer\\\");\\n        require(targets.length > 0 && targets.length == dataElements.length, \\\"Bad operation\\\");\\n\\n        bytes32 id = getOperationId(targets, dataElements, salt);\\n        require(readyAt[tx.origin][id] == 0, \\\"Already scheduled\\\");\\n\\n        uint256 ready = block.timestamp + delayOf(tx.origin);\\n        readyAt[tx.origin][id] = ready;\\n        emit OperationScheduled(tx.origin, id, ready);\\n    }\\n\\n    function execute(address[] calldata targets, bytes[] calldata dataElements, bytes32 salt) external {\\n        _bindSolver();\\n        require(targets.length > 0 && targets.length == dataElements.length, \\\"Bad operation\\\");\\n\\n        bytes32 id = getOperationId(targets, dataElements, salt);\\n\\n        for (uint256 i = 0; i < targets.length; i++) {\\n            require(targets[i] != nftContract, \\\"Forbidden target\\\");\\n            (bool success, bytes memory result) = targets[i].call(dataElements[i]);\\n            if (!success) {\\n                assembly {\\n                    revert(add(result, 0x20), mload(result))\\n                }\\n            }\\n        }\\n\\n        uint256 ready = readyAt[tx.origin][id];\\n        require(ready != 0, \\\"Operation not scheduled\\\");\\n        require(block.timestamp >= ready, \\\"Operation not ready\\\");\\n\\n        readyAt[tx.origin][id] = type(uint256).max;\\n        emit OperationExecuted(tx.origin, id);\\n    }\\n\\n    function grantProposer(address account) external onlySelf {\\n        proposers[tx.origin][account] = true;\\n    }\\n\\n    function updateDelay(uint64 newDelay) external onlySelf {\\n        require(newDelay <= MAX_DELAY, \\\"Delay too long\\\");\\n        _delays[tx.origin] = newDelay;\\n        _delaySet[tx.origin] = true;\\n    }\\n\\n    function mintFlag() external onlySelf {\\n        require(delayOf(tx.origin) >= 1 hours, \\\"Delay too short\\\");\\n        require(msg.data.length == 0x24, \\\"Wrong calldata length\\\");\\n\\n        uint256 player;\\n        assembly {\\n            player := calldataload(0x04)\\n        }\\n        require(player == uint256(uint160(tx.origin)), \\\"Wrong player\\\");\\n\\n        INFTFlags(nftContract).mint(tx.origin, 7);\\n    }\\n\\n    function _bindSolver() private {\\n        if (msg.sender == tx.origin || msg.sender == address(this)) return;\\n        address owner = solverOwner[msg.sender];\\n        if (owner == address(0)) {\\n            solverOwner[msg.sender] = tx.origin;\\n        } else {\\n            require(owner == tx.origin, \\\"Solver bound to another agent\\\");\\n        }\\n    }\\n}\\n\",\"keccak256\":\"0xb456c7cc2ae1fd99fa09bfd9fdc77194a420b810d1fc99762ec0f5efd3e41ff4\",\"license\":\"MIT\"}},\"version\":1}",
